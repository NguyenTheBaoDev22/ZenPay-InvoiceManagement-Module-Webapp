# ZenShop Invoice Management Module - Production Environment
# API Configuration
VITE_API_BASE_URL=https://api.zenshop.zenpay.com.vn/api
VITE_API_TIMEOUT=30000

# ZenShop API Endpoints
VITE_ZENSHOP_API_URL=https://api.zenshop.zenpay.com.vn
VITE_ZENSHOP_API_HTTPS_URL=https://api.zenshop.zenpay.com.vn

# ZenInvoice API Endpoints
VITE_ZENINVOICE_API_URL=https://api.zeninvoice.com
VITE_ZENINVOICE_API_HTTPS_URL=https://api.zeninvoice.com

# Production Settings
VITE_NODE_ENV=production
VITE_DEBUG_MODE=false
VITE_ENABLE_API_LOGGING=false
