# ZenShop Invoice Management Module - Development Environment
# API Configuration
VITE_API_BASE_URL=https://localhost:7242/api
VITE_API_TIMEOUT=30000

# ZenShop API Endpoints
VITE_ZENSHOP_API_URL=https://localhost:7242
VITE_ZENSHOP_API_HTTPS_URL=https://localhost:7242

# ZenInvoice API Endpoints (for reference)
VITE_ZENINVOICE_API_URL=http://127.0.0.1:5119
VITE_ZENINVOICE_API_HTTPS_URL=https://127.0.0.1:7241

# Development Settings
VITE_NODE_ENV=development
VITE_DEBUG_MODE=true
VITE_ENABLE_API_LOGGING=true
